#!/usr/bin/env bash
# studio-secrets <cmd…>: run one command with the studio's keys from work/.env.op (1Password references, yours), e.g. `studio-secrets studio voice <p>`.
# The 1Password service-account token comes from the keychain and is set only for `op`; `op run` would pass it on
# to the command, so `env -u` strips it there: no shell and no command environment carries it. That's hygiene, not a
# wall: code running as this user can still read the keychain item or op's environment (`ps -E`). The service account
# being read-only on one vault is what bounds the damage.
set -euo pipefail

KEYCHAIN_SERVICE="op-service-account-media-studio"
repo="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"

if (( $# == 0 )); then
  echo "usage: studio-secrets <command> [args…]   e.g. studio-secrets studio voice <project>" >&2
  exit 64
fi

if ! token="$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null)" || [[ -z "$token" ]]; then
  echo "studio-secrets: no '$KEYCHAIN_SERVICE' item in the macOS keychain (or access was denied)." >&2
  echo "Store a 1Password service account's token there: security add-generic-password -s $KEYCHAIN_SERVICE -a \"\$USER\" -w" >&2
  exit 1
fi
if [[ ! -f "$repo/work/.env.op" ]]; then
  echo "studio-secrets: no work/.env.op; write one naming each key as an op:// reference (README.md, Secrets)." >&2
  exit 1
fi

OP_SERVICE_ACCOUNT_TOKEN="$token" exec op run --env-file="$repo/work/.env.op" -- env -u OP_SERVICE_ACCOUNT_TOKEN -- "$@"
