#!/usr/bin/env bash
# studio-secrets <cmd…>: run one command with the studio's keys from .env.op, e.g. `studio-secrets studio voice <p>`.
# The 1Password service-account token comes from the keychain and is set only for `op`; `op run` would pass it on
# to the command, so `env -u` strips it there. The command sees the resolved keys and never the token that reads them.
set -euo pipefail

KEYCHAIN_SERVICE="op-service-account-video-studio"
repo="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"

if (( $# == 0 )); then
  echo "usage: studio-secrets <command> [args…]   e.g. studio-secrets studio voice <project>" >&2
  exit 64
fi

if ! token="$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null)" || [[ -z "$token" ]]; then
  echo "studio-secrets: no '$KEYCHAIN_SERVICE' item in the macOS keychain (or access was denied)." >&2
  echo "Set up the 1Password service account with: $repo/scratch/op-service-account-setup.sh" >&2
  exit 1
fi

OP_SERVICE_ACCOUNT_TOKEN="$token" exec op run --env-file="$repo/.env.op" -- env -u OP_SERVICE_ACCOUNT_TOKEN -- "$@"
