{
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // Deliberately no host files: a scene imports its host as `@host/…`, which lib/output/render/engine/host-modules.d.ts types as `any`, so
  // tsc never reads the host (its aliases, env types and server code only type-check under its own settings).
  "include": ["lib", "lint", "cli", "harness", "remotion.config.ts", "types.d.ts", "work/projects", "work/brands", "work/styles"],
  // Generated modules and render output: nothing hand-written to check.
  "exclude": ["work/projects/*/generated", "work/projects/*/out"]
}
