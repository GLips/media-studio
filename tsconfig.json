{
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // Deliberately no host files: a scene imports its host as `@host/…`, which lib/host-modules.d.ts types as `any`, so
  // tsc never reads the host (its aliases, env types and server code only type-check under its own settings).
  "include": ["lib", "cli", "lab", "projects/*/video.tsx", "projects/*/capture.ts", "remotion.config.ts", "types.d.ts"]
}
