// The web app's lint: tk2's catalog (lint/catalog/, vendored whole) plus oxlint's built-ins, as tk2 enables them.
// `npm run lint` runs it over web/src, the one tree lint/catalog/policy/declared-trees.ts declares. lib/, cli/ and
// work/projects/ answer to the studio's own tier (npm run check:arch) instead.
//
// Suppressing one line: `// oxlint-disable-next-line arch/<rule>`, with the reason beside it.
{
  // One module for the catalog: `meta.name` is `arch`, and every `arch/` key below inherits it.
  "jsPlugins": ["./lint/catalog/oxlint/plugin.ts", "eslint-plugin-sonarjs"],

  // An explicit array REPLACES oxlint's default (unicorn, typescript, oxc) rather than adding to it, and a rule whose
  // plugin is missing here is dropped silently. `import` and `promise` carry the `import/` rules named below.
  "plugins": ["react", "unicorn", "typescript", "oxc", "import", "promise"],

  // One `<root>/<generatedDir>/**` per declared tree, then build output. `lint/**` is the vendored catalog: its own
  // specs (npm run test:lint) and tsc programs (npm run typecheck:lint) cover it, and fixing a finding there forks it.
  "ignorePatterns": ["web/src/gen/**", "lint/**", "**/dist/**", "**/.output/**", "**/.tanstack/**", "**/routeTree.gen.ts"],

  // Type-aware needs oxlint-tsgolint; its type information reaches the built-in `typescript/*` rules only.
  "options": { "typeAware": true, "reportUnusedDisableDirectives": "warn" },

  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off"
  },

  "rules": {
    "arch/no-module-mocking": "error",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "sonarjs/duplicates-in-character-class": "error",
    "sonarjs/no-all-duplicated-branches": "error",
    "sonarjs/no-duplicate-in-composite": "error",
    "sonarjs/no-duplicate-test-title": "error",
    "sonarjs/no-duplicated-branches": "error",
    "sonarjs/no-identical-conditions": "error",
    "sonarjs/no-identical-expressions": "error",
    "sonarjs/no-identical-functions": "error",
    "no-nested-ternary": "error",
    "react/set-state-in-effect": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/react-in-jsx-scope": "off",
    "no-console": "error",
    "eqeqeq": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "import/no-default-export": "error",
    "import/no-duplicates": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "no-underscore-dangle": "off"
  },

  "overrides": [
    {
      // Exactly the declared trees' roots: a tree declared but not listed here is policed by the structural tier
      // alone, and a root listed but not declared makes every `arch/` rule silent there.
      "files": ["web/src/**"],
      "rules": {
        "arch/barrel-direction": "error",
        "arch/server-import-context": "error",
        "arch/ambient-globals": "error",
        "arch/client-server-infra": "error",
        "arch/db-isolation": "error",
        "arch/import-policy": "error",
        "arch/no-test-imports": "error",
        "arch/route-thinness": "error",
        "arch/sdk-containment": "error",
        "arch/server-no-upward": "error",
        "arch/no-disable-validation": "error",
        "arch/no-effect-catchallcause": "error",
        "arch/no-nested-layer-provide": "error",
        "arch/no-service-option": "error",
        "arch/no-silent-error-swallow": "error",
        "arch/no-sql-type-parameter": "error",
        "arch/no-long-comments": "error",
        "arch/no-vacant-symbol-names": "error",
        "arch/deprecated-paths": "error",
        "arch/no-deprecated-input-validator": "error",
        "arch/no-plain-export-in-server-fn-module": "error",
        "arch/no-raw-result": "error",
        "arch/schema-placement": "error",
        "arch/server-fn-placement": "error",
        "arch/server-fn-validation": "error",
        "arch/no-async-effect": "error",
        "arch/hook-count": "warn",
        "arch/prop-count": "warn",
        "arch/single-component-export": "warn",
        "arch/no-arbitrary-class-values": "error",
        "arch/no-inline-color": "error",
        "arch/no-inline-font-size": "error",
        "arch/no-stylex-border-shorthand": "error",
        "arch/no-inline-style-prop": "error",
        "arch/no-raw-primitives": "error",
        "arch/vendor-component-containment": "error",
        "arch/no-chained-type-assertions": "error",
        "arch/no-reflect-access": "error",
        "arch/no-type-argument-assertion": "error",
        "arch/require-safety-comment": "error",
        "arch/no-conditional-empty-object-spread": "warn"
      }
    },
    {
      "files": [
        "**/*.test.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "**/__tests__/**",
        "test/**",
        "**/*.d.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "**/*.gen.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "**/scripts/**"
      ],
      "rules": {
        "no-nested-ternary": "off",
        "react/set-state-in-effect": "off",
        "react/no-deriving-state-in-effects": "off"
      }
    },
    {
      // TanStack's file routes and Vite's config are default exports by the framework's contract.
      "files": ["**/*.config.ts", "**/routes/**", "**/*.tsx", "web/**"],
      "rules": {
        "import/no-default-export": "off",
        "no-console": "off"
      }
    }
  ]
}
