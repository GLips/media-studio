#!/bin/sh
# The workspace's pre-commit gate (work/ is its own repository; lib/platform/project/engine/studio-workspace.ts points its
# core.hooksPath here): check:arch over the index this commit holds, read against the studio's own index, and lint over
# the sources that index holds; then the typecheck over all but the workspace's untracked paths, and the workspace
# projects' tests. Each runs on its own, so one failure doesn't hide the next. Another session's untracked,
# half-written file is nobody's commit yet, and mustn't block this one: check:arch and lint list the sources they left
# unchecked.
#
# Git runs this in work/ with GIT_DIR and GIT_INDEX_FILE possibly relative to it. check:arch and lint run from the
# studio's root, so both are made absolute first: they read the workspace in this environment, and check:arch reads
# the studio without it.

# core.hooksPath names the main studio checkout's copy of these hooks (an absolute path: a relative one resolves
# from each worktree's own top and finds nothing for a work/ worktree made anywhere else, and git then skips every
# hook without a word). Each hook hands over to the copy in the studio checkout that holds this worktree as its work/,
# so a studio worktree's work/ runs that worktree's hooks; a work/ worktree outside any studio checkout is refused,
# since its #styles and #brands imports would resolve to some other checkout's work/.
top=$(git rev-parse --show-toplevel) || exit 1
owner=$(cd "$top/.." && pwd -P)
if [ "$(basename "$top")" != work ] || [ ! -f "$owner/.githooks-workspace/pre-commit" ]; then
  echo "workspace: $top isn't the work/ of a studio checkout, so its imports and this hook can't find their studio." >&2
  echo "workspace: make a work/ worktree at <studio worktree>/work (git -C <main>/work worktree add <studio worktree>/work)." >&2
  exit 1
fi
here=$(cd "$(dirname "$0")/.." && pwd -P)
[ "$owner" = "$here" ] || exec "$owner/.githooks-workspace/$(basename "$0")" "$@"

GIT_DIR=$(git rev-parse --absolute-git-dir) && export GIT_DIR
case "${GIT_INDEX_FILE:-}" in
  '') ;;
  /*) ;;
  *) GIT_INDEX_FILE="$(pwd)/$GIT_INDEX_FILE"; export GIT_INDEX_FILE ;;
esac
workspace_index=$(git rev-parse --path-format=absolute --git-path index) || exit 1
cd "$(dirname "$0")/.." || exit 1

failed=''
npm run -s check:arch -- --scope workspace --snapshot index || failed="$failed check:arch"
npm run -s lint -- --scope workspace --snapshot index || failed="$failed lint"

# A test's throwaway repo must never see the hook's git environment, or its git commands land in the workspace.
for name in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$name"; done

# The typecheck leaves out the workspace's untracked paths, as check:arch and lint do: tsc -p a config extending the
# studio's, its exclude widened by them. A tracked file that imports one still checks it. effect-tsgo runs it, as the
# studio's scripts do: plain tsc ignores the Effect language service's plugin and its diagnostics.
npm run -s typecheck -- --tracked "$workspace_index" || failed="$failed typecheck"
log=$(mktemp)
npm run -s test:workspace -- --tracked "$workspace_index" > "$log" 2>&1 || { tail -n 60 "$log"; failed="$failed test"; }
rm -f "$log"

if [ -n "$failed" ]; then
  echo "workspace pre-commit gate: failed$failed. Fix it and commit again." >&2
  exit 1
fi
