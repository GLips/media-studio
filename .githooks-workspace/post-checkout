#!/bin/sh
# Seeds a new work/ worktree with clones of the main workspace checkout's gitignored, made files (captures, music,
# voice manifests, generated assets, brush packs). Tracked code imports them, so without them a worktree's commits
# fail the typecheck, lint and tests that .githooks-workspace/pre-commit runs.
# Git passes a null previous HEAD only when it makes a checkout (git worktree add, git clone); a branch switch keeps
# what's there. `studio workspace seed` does the same by hand.
#
# It calls the module, not the studio CLI: a fresh studio worktree may not have node_modules yet, and the module needs
# only Node's builtins.

# core.hooksPath names the main studio checkout's copy of these hooks (an absolute path: a relative one resolves
# from each worktree's own top and finds nothing for a work/ worktree made anywhere else, and git then skips every
# hook without a word). Each hook hands over to the copy in the studio checkout that holds this worktree as its work/,
# so a studio worktree's work/ runs that worktree's hooks; a work/ worktree outside any studio checkout is refused,
# since its #styles and #brands imports would resolve to some other checkout's work/.
top=$(git rev-parse --show-toplevel) || exit 1
owner=$(cd "$top/.." && pwd -P)
if [ "$(basename "$top")" != work ] || [ ! -f "$owner/.githooks-workspace/post-checkout" ]; then
  echo "workspace: $top isn't the work/ of a studio checkout, so its imports and this hook can't find their studio." >&2
  echo "workspace: make a work/ worktree at <studio worktree>/work (git -C <main>/work worktree add <studio worktree>/work)." >&2
  exit 1
fi
here=$(cd "$(dirname "$0")/.." && pwd -P)
[ "$owner" = "$here" ] || exec "$owner/.githooks-workspace/$(basename "$0")" "$@"

case "$1" in
  0000000000000000000000000000000000000000) ;;
  *) exit 0 ;;
esac
studio="$(cd "$(dirname "$0")/.." && pwd)"
node --input-type=module -e "
const { seedWorkspaceWorktree } = await import(process.argv[1] + '/lib/platform/project/engine/workspace-seed.ts');
const plan = seedWorkspaceWorktree(process.cwd());
if (plan) console.error(plan.clone.length ? 'workspace: seeded ' + plan.clone.length + ' made paths from the main checkout' : 'workspace: nothing to seed');
" "$studio" || echo 'workspace: seeding failed; run studio workspace seed' >&2
