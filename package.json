  },
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.525",
    "@remotion/captions": "4.0.525",
    "@remotion/cli": "4.0.525",
    "@remotion/install-whisper-cpp": "4.0.525",
    "@remotion/media": "4.0.525",
    "@remotion/renderer": "4.0.525",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.525"
  }
