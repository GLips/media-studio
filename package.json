{
  "name": "media-studio",
  "version": "1.0.0",
  "description": "Videos and stills made in code: capture, voice, music, compose, render.",
  "bin": {
    "studio": "cli/studio.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "typecheck:gate": "tsc -p tsconfig.gate.json",
    "test": "node --test 'lib/**/*.test.ts' 'lint/**/*.test.ts' 'projects/**/*.test.ts'",
    "test:gate": "node --test 'lib/**/*.test.ts' 'lint/**/*.test.ts'",
    "check:arch": "node lint/check-arch.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "type": "module",
  "imports": {
    "#engine/*": "./lib/engine/*",
    "#models/*": "./lib/models/*",
    "#studio": "./lib/studio/api.ts",
    "#studio/*": "./lib/studio/*"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "oxc-parser": "^0.150.0",
    "playwright": "^1.63.0",
    "typescript": "7.0.2"
  },
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.525",
    "@remotion/captions": "4.0.525",
    "@remotion/cli": "4.0.525",
    "@remotion/fonts": "^4.0.525",
    "@remotion/install-whisper-cpp": "4.0.525",
    "@remotion/media": "4.0.525",
    "@remotion/paths": "4.0.525",
    "@remotion/player": "4.0.525",
    "@remotion/renderer": "4.0.525",
    "citty": "0.2.2",
    "esbuild": "0.28.1",
    "p5": "2.3.3",
    "p5.brush": "2.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.525",
    "three": "0.186.0"
  }
}
